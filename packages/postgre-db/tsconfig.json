{
  "extends": "@repo/typescript-config/base.json",
  "ts-node": { "logError": true },
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",

    "declaration": true,
    "declarationMap": true,
    // "emitDeclarationOnly": false,

    "strict": true,
    "esModuleInterop": true,

    "paths": {
      "types": ["../types/src/*"]
    }
  },
  "include": ["src", "prisma.config.ts"],
  "exclude": ["node_modules"]
}
