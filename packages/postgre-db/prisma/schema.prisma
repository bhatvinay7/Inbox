datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
model User {
  id        String @id @default(uuid()) @db.Uuid
  email     String   @unique
  password String?    
  name      String?
  role      Role     @default(USER)
  refreshToken String? @default("") 
  createdAt DateTime @default(now())
  session   NoteSession[]
@@index([id], name: "note_user_id_idx")
@@index([email], name: "note_user_email_idx")
}

